{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Database:Provider = Sqlite (default) | PostgreSql | SqlServer.
  // ConnectionStrings:Events is optional for Sqlite (defaults to a local file)
  // and required for PostgreSql / SqlServer.
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Events": "Data Source=intelligencekit.db"
  }
}
