<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <!-- Pin the native SQLite bundle to a patched version (transitive default
         2.1.11 has advisory GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IntelligenceKit.Core\IntelligenceKit.Core.csproj" />
    <ProjectReference Include="..\IntelligenceKit.Server.Contracts\IntelligenceKit.Server.Contracts.csproj" />
    <ProjectReference Include="..\IntelligenceKit.Server.Data\IntelligenceKit.Server.Data.csproj" />
    <!-- Provider-specific migration assemblies, loaded by name at runtime. -->
    <ProjectReference Include="..\IntelligenceKit.Server.Migrations.Sqlite\IntelligenceKit.Server.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\IntelligenceKit.Server.Migrations.PostgreSql\IntelligenceKit.Server.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="..\IntelligenceKit.Server.Migrations.SqlServer\IntelligenceKit.Server.Migrations.SqlServer.csproj" />
  </ItemGroup>

</Project>
