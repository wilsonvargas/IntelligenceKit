<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NuGet package -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>IntelligenceKit.Extensions.Logging</PackageId>
    <Title>IntelligenceKit logging provider</Title>
    <Description>Microsoft.Extensions.Logging provider for IntelligenceKit: log entries become breadcrumbs, and errors become grouped events — builder.Logging.AddIntelligenceKit().</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IntelligenceKit.Core\IntelligenceKit.Core.csproj" />
  </ItemGroup>

</Project>
