@page "/events"
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Nav
@inject LiveEventsClient Live

<PageTitle>Events — IntelligenceKit</PageTitle>

<div class="d-flex align-items-center gap-3 mb-4">
    <h1 class="page-title">Events</h1>
    <span class="live-pill @(_live ? "on" : "off")">
        <span class="live-dot @(_live ? "on" : "")"></span> @(_live ? "Live" : "Offline")
    </span>
</div>

<div class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md-4">
        <label class="form-label small text-muted mb-1">Project</label>
        <input class="form-control form-control-sm" placeholder="all projects"
               @bind="_projectId" @bind:event="oninput" />
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label small text-muted mb-1">Event type</label>
        <select class="form-select form-select-sm" @bind="_eventType">
            <option value="">all</option>
            <option value="Exception">Exception</option>
            <option value="Log">Log</option>
            <option value="Unknown">Unknown</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <button class="btn btn-primary btn-sm w-100" @onclick="ApplyFilters">Apply</button>
    </div>
    <div class="col-6 col-md-2">
        <button class="btn btn-outline-secondary btn-sm w-100" @onclick="ClearFilters">Clear</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_page is null)
{
    <p class="text-muted">Loading events…</p>
}
else if (_page.Items.Count == 0)
{
    <div class="alert alert-info">No events match the current filters.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead>
                <tr>
                    <th>Received</th>
                    <th>Type</th>
                    <th>Env</th>
                    <th>Project</th>
                    <th>App</th>
                    <th>Platform</th>
                    <th>Device</th>
                    <th>Summary</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in _page.Items)
                {
                    <tr role="button" @onclick="() => Open(e.Id)">
                        <td class="text-nowrap small">@e.ReceivedAt.ToLocalTime().ToString("g")</td>
                        <td><span class="badge @BadgeClass(e.EventType)">@e.EventType</span></td>
                        <td><span class="text-muted small">@e.Environment</span></td>
                        <td class="text-truncate" style="max-width: 12rem;" title="@e.ProjectId">@e.ProjectId</td>
                        <td class="text-nowrap">@e.ApplicationName <span class="text-muted small">@e.ApplicationVersion</span></td>
                        <td>@e.Platform</td>
                        <td class="text-truncate" style="max-width: 10rem;" title="@e.DeviceName">@e.DeviceName</td>
                        <td class="text-truncate" style="max-width: 20rem;" title="@(e.ExceptionMessage ?? "")">
                            @if (e.ExceptionType is not null)
                            {
                                <span class="text-danger">@e.ExceptionType</span>
                                <span class="text-muted">— @e.ExceptionMessage</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(e.Message))
                            {
                                @if (e.Level is not null)
                                {
                                    <span class="text-muted small me-1">[@e.Level]</span>
                                }
                                <span>@e.Message</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <div class="text-muted small">
            Showing @(_skip + 1)–@(_skip + _page.Items.Count) of @_page.Total
        </div>
        <div class="btn-group">
            <button class="btn btn-outline-secondary btn-sm" @onclick="Prev" disabled="@(_skip == 0)">Previous</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="Next" disabled="@(!HasNext)">Next</button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? ProjectId { get; set; }
    [SupplyParameterFromQuery] public string? EventType { get; set; }

    private const int PageSize = 50;

    private string? _projectId;
    private string? _eventType;
    private int _skip;
    private PagedResult<EventSummary>? _page;
    private string? _error;
    private bool _live;
    private bool _subscribed;

    private bool HasNext => _page is not null && _skip + _page.Items.Count < _page.Total;

    protected override async Task OnInitializedAsync()
    {
        // Connect the live feed once for the lifetime of this page instance.
        Live.EventReceived += OnLiveEvent;
        _subscribed = true;
        try
        {
            await Live.EnsureStartedAsync();
            _live = Live.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;
        }
        catch
        {
            _live = false; // real-time unavailable; the page still works via polling/refresh
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // React to query-string changes (e.g. arriving from the projects page).
        _projectId = ProjectId;
        _eventType = EventType;
        _skip = 0;
        await LoadAsync();
    }

    private void OnLiveEvent(EventSummary e)
    {
        // Only surface events that belong in the current view: matching filters,
        // and only while on the first page (so paging stays stable).
        if (_skip != 0 || _page is null)
            return;
        if (!string.IsNullOrWhiteSpace(_projectId) && !string.Equals(e.ProjectId, _projectId, StringComparison.OrdinalIgnoreCase))
            return;
        if (!string.IsNullOrWhiteSpace(_eventType) && !string.Equals(e.EventType, _eventType, StringComparison.OrdinalIgnoreCase))
            return;
        if (_page.Items.Any(i => i.Id == e.Id))
            return;

        var items = new List<EventSummary> { e };
        items.AddRange(_page.Items.Take(PageSize - 1));
        _page = _page with { Total = _page.Total + 1, Items = items };

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_subscribed)
            Live.EventReceived -= OnLiveEvent;
    }

    private async Task LoadAsync()
    {
        _error = null;
        _page = null;
        try
        {
            _page = await Api.GetEventsAsync(_projectId, _eventType, _skip, PageSize);
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the API: {ex.Message}";
        }
    }

    private void ApplyFilters()
    {
        // Push filters into the URL so the view is shareable/bookmarkable.
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(_projectId))
            query.Add($"projectId={Uri.EscapeDataString(_projectId)}");
        if (!string.IsNullOrWhiteSpace(_eventType))
            query.Add($"eventType={Uri.EscapeDataString(_eventType)}");

        Nav.NavigateTo(query.Count == 0 ? "/events" : $"/events?{string.Join('&', query)}");
    }

    private void ClearFilters() => Nav.NavigateTo("/events");

    private async Task Prev()
    {
        _skip = Math.Max(0, _skip - PageSize);
        await LoadAsync();
    }

    private async Task Next()
    {
        if (!HasNext) return;
        _skip += PageSize;
        await LoadAsync();
    }

    private void Open(Guid id) => Nav.NavigateTo($"/events/{id}");

    private static string BadgeClass(string eventType) => eventType switch
    {
        "Exception" => "text-bg-danger",
        "Log" => "text-bg-secondary",
        _ => "text-bg-light"
    };
}
