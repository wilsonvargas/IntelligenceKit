<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NuGet package -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>IntelligenceKit.Hosting</PackageId>
    <Title>IntelligenceKit for any .NET host</Title>
    <Description>Generic IntelligenceKit SDK for .NET apps without a platform package (console, workers, desktop): services.AddIntelligenceKit(dsn) or IntelligenceKitSdk.Init(dsn). Crash capture, offline file queue, sessions, performance and ILogger integration. Base of the ASP.NET Core, WPF, WinForms, Avalonia and Blazor SDKs.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IntelligenceKit.Core\IntelligenceKit.Core.csproj" />
    <ProjectReference Include="..\IntelligenceKit.Extensions.Logging\IntelligenceKit.Extensions.Logging.csproj" />
  </ItemGroup>

</Project>
